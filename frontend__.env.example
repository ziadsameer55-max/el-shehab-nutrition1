# EL SHEHAB NUTRITION: Developed & Powered by CODING Systems

# Where Next.js proxies /api and /sanctum (server-side only)
BACKEND_URL=http://127.0.0.1:8000

# Public origin of this site. Sent as Referer so Laravel Sanctum treats server-side calls as the SPA.
# Must match a host listed in SANCTUM_STATEFUL_DOMAINS in backend/.env
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must equal SESSION_COOKIE in backend/.env (used only to detect "has a session", never to trust it)
SESSION_COOKIE_NAME=esn_session

# Official logos supplied by the client / CODING Systems, placed under public/brand/.
# Leave empty until the files are provided: the UI then shows the brand NAME as text, not an invented logo.
NEXT_PUBLIC_CLIENT_LOGO=
NEXT_PUBLIC_DEV_LOGO=
