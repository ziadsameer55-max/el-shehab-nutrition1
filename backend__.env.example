# EL SHEHAB NUTRITION: Developed & Powered by CODING Systems
APP_NAME="EL SHEHAB NUTRITION"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=UTC
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# PostgreSQL 16+
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=el_shehab
DB_USERNAME=el_shehab
DB_PASSWORD=
DB_SSLMODE=prefer

# Sanctum SPA (cookie) auth: Next.js proxies /api to Laravel so everything is same-origin
SESSION_DRIVER=database
SESSION_COOKIE=esn_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=example.com
FRONTEND_URL=https://example.com

CACHE_STORE=database
QUEUE_CONNECTION=database

# Private files (payment receipts, health files). Never served directly by the web server.
FILESYSTEM_DISK=private

# Mail (password reset + notifications)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="EL SHEHAB NUTRITION"

# One-time doctor account created by `php artisan db:seed`
# Choose a strong password (12+ chars) and remove these lines from .env after seeding.
DOCTOR_NAME=
DOCTOR_EMAIL=
DOCTOR_PASSWORD=

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=warning
